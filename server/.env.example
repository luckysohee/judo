# API 서버 (Railway · Render · Fly 등)
# Start: npm start (PORT 는 플랫폼이 설정)

PORT=4000

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# service_role JWT (Supabase 대시보드 → API → service_role). 로컬 .env 의 SUPABASE_KEY 와 동일 값
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SUPABASE_KEY=...  ← 위와 같은 값으로 써도 됨 (코드가 둘 다 읽음)

OPENAI_API_KEY=sk-...
KAKAO_REST_API_KEY=

# Node → Google Places API (New). 브라우저용 VITE_ 키와 별도
GOOGLE_PLACES_API_KEY=

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# API 보안 (CORS·rate limit·JWT)
# 프로덕션: Vercel 앱 URL 포함 (쉼표 구분). 비우면 production 에서 브라우저 Origin 전부 거부
# API_CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
SUPABASE_ANON_KEY=
# API_REQUIRE_AUTH=false  ← 로컬만 JWT 검증 끄기
# API_RATE_LIMIT_MAX=120
# API_RATE_LIMIT_EXPENSIVE_MAX=24
# API_RATE_LIMIT_KAKAO_LOCAL_MAX=40
# API_RATE_LIMIT_WINDOW_MS=60000
# 카카오 Local 업스트림 보호 (캐시·큐)
# KAKAO_LOCAL_CACHE_TTL_MS=90000
# KAKAO_LOCAL_MIN_GAP_MS=120
# KAKAO_LOCAL_COOLDOWN_MS=8000

# 선택
# PYTHON_PATH=python3
# DEBUG_KATECH=0
