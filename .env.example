# 로컬 개발 — 이 파일을 복사: cp .env.example .env
# npm run dev (루트) = server:4000 + Vite:5173, /api 는 Vite 프록시

# ── Supabase (프론트) ──
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# ⚠️ service role 은 절대 VITE_ 접두사로 넣지 마세요 (빌드에 노출됨)
# 서버 전용 키는 아래 SUPABASE_* 또는 server/.env 에만

# ── Supabase (API 서버) ──
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# 또는 SUPABASE_KEY=...

# ── API 서버 (OpenAI · 카카오 · Places) ──
OPENAI_API_KEY=sk-...
KAKAO_REST_API_KEY=
GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACES_API_KEY = 서버 전용 (리퍼러 제한 없는 키). VITE_GOOGLE_PLACES_API_KEY 와 다름

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 카카오 · 네이버 (프론트 — 지도/스튜디오) ──
VITE_KAKAO_JAVASCRIPT_KEY=
VITE_KAKAO_REST_API_KEY=
VITE_NAVER_CLIENT_ID=
VITE_NAVER_CLIENT_SECRET=
VITE_GOOGLE_PLACES_API_KEY=

# ── 로컬: 비우면 Vite 프록시가 /api → localhost:4000 ──
# VITE_AI_API_BASE_URL=http://localhost:4000

# ── 선택 ──
# VITE_HOME_COURSE_EDITOR_PICK_IDS=uuid1,uuid2
# VITE_ADMIN_USER_ID=
# VITE_ENABLE_COURSE_COMPOSE_ASSIST=false
# VITE_VERBOSE_HOME=0
# VITE_VERBOSE_SEARCH=0
# CURATOR_PLACES_CURATOR_ID_MODE=user_id
