# 로컬 개발 — 이 파일을 복사: cp .env.example .env
# npm run dev (루트) = server:4000 + Vite:5173, /api 는 Vite 프록시
#
# 배포 (클로즈드 베타)
#   Phase 1: Vercel (모바일 웹) + Railway (server/) + Supabase — 지인 10~20명 스모크
#   Phase 2: 안정화 후 Capacitor iOS TestFlight (동일 Railway/Supabase)

# ── Supabase (프론트) ──
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# ⚠️ service role 은 절대 VITE_ 접두사로 넣지 마세요 (빌드에 노출됨)
# 서버 전용 키는 아래 SUPABASE_* 또는 server/.env 에만

# ── Supabase (API 서버) ──
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# 또는 SUPABASE_KEY=...

# ── API 서버 (OpenAI · 카카오 · Places · 네이버) — 서버 전용, VITE_ 금지 ──
OPENAI_API_KEY=sk-...
KAKAO_REST_API_KEY=
GOOGLE_PLACES_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 카카오 지도 (프론트 — JavaScript SDK, 도메인 제한 키) ──
VITE_KAKAO_JAVASCRIPT_KEY=
# REST/Places/네이버 시크릿은 server/.env 의 KAKAO_REST_API_KEY 등만 사용 (/api/* 프록시)

# ── API 서버 (Railway) — CORS 화이트리스트에 Vercel 도메인 넣기 ──
# API_CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# ── 로컬: 비우면 Vite 프록시가 /api → localhost:4000 ──
# VITE_AI_API_BASE_URL=http://localhost:4000

# ── 로컬 개발: 매번 계정 선택 · 새로고침 시 로그아웃 (DEV 전용) ──
# VITE_AUTH_DEV_FRESH_LOGIN=true

# ── 선택 ──
# VITE_HOME_COURSE_EDITOR_PICK_IDS=uuid1,uuid2
# VITE_ADMIN_USER_ID=
# VITE_ENABLE_COURSE_COMPOSE_ASSIST=false
# VITE_VERBOSE_HOME=0
# VITE_VERBOSE_SEARCH=0
# CURATOR_PLACES_CURATOR_ID_MODE=user_id
