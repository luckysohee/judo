# Phase 1 — Vercel 모바일 웹/PWA (git push → 즉시 배포, 10~20명 실사용 검증)
# API: Railway (server/) · DB/Auth: Supabase
# Phase 2 — 체크인/코스/검색 안정화 후 Capacitor iOS TestFlight

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# 배포된 API 서버 HTTPS URL (끝 슬래시 없음)
VITE_AI_API_BASE_URL=https://your-api.example.com

# 카카오 지도 JavaScript SDK — REST 키(VITE_KAKAO_REST_API_KEY)와 별도
# Vercel 변수명 must match exactly: VITE_KAKAO_JAVASCRIPT_KEY
VITE_KAKAO_JAVASCRIPT_KEY=

# 스튜디오 장소 검색 등 클라이언트에서 REST 호출 시
VITE_KAKAO_REST_API_KEY=

# ── 선택 ──
# VITE_HOME_COURSE_EDITOR_PICK_IDS=
# VITE_ADMIN_USER_ID=

# ── 넣지 말 것 ──
# VITE_SUPABASE_SERVICE_ROLE_KEY  ← 빌드 번들 노출 위험
# OPENAI_API_KEY                    ← 서버 env 만
# SUPABASE_SERVICE_ROLE_KEY         ← 서버 env 만
