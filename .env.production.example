# Phase 1 — Vercel 모바일 웹/PWA (git push → 즉시 배포, 10~20명 실사용 검증)
# API: Railway (server/) · DB/Auth: Supabase
# Phase 2 — 체크인/코스/검색 안정화 후 Capacitor iOS TestFlight

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# API — Vercel 배포 시 비우기 권장 (vercel.json이 /api → Railway 프록시, CORS 없음)
# 로컬만: http://localhost:4000
# VITE_AI_API_BASE_URL=

# 카카오 지도 JavaScript SDK (도메인 제한 키)
# Vercel 변수명 must match exactly: VITE_KAKAO_JAVASCRIPT_KEY
VITE_KAKAO_JAVASCRIPT_KEY=

# 클로즈드 알파 — 지인 20명 등 초대 이메일만 접근 (로컬은 기본 off)
VITE_ALPHA_ALLOWLIST_ENABLED=true

# Railway 에도 ALPHA_ALLOWLIST_ENABLED=true 설정 (API /api/* JWT+allowlist)
# Supabase: INSERT INTO alpha_access_allowlist (email, label) VALUES ('you@gmail.com', '본인');

# ── 넣지 말 것 (서버 Railway env 만) ──
# KAKAO_REST_API_KEY / GOOGLE_PLACES_API_KEY / NAVER_CLIENT_SECRET
# OPENAI_API_KEY / SUPABASE_SERVICE_ROLE_KEY
# VITE_SUPABASE_SERVICE_ROLE_KEY  ← 빌드 번들 노출 위험
